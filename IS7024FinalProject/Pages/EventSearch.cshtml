@page
@model IS7024FinalProject.Pages.EventSearchModel
@using IS7024FinalProject.Pages
@using System.Globalization

@{
ViewData["Title"] = "Event Search";
}

<!-- The content below will be placed inside the <body> and <main> tags of _Layout.cshtml, which already loads Bootstrap. -->

<div class="container my-5">
<div class="text-center mb-4">
<h1 class="display-4 text-primary">Event Finder</h1>
<p class="lead">Search the SeatGeek API for events near you.</p>
</div>

<!-- Search Form Section - ID changed from 'search' to 'event-search-area' to avoid static width in site.css -->

<div id="event-search-area" class="row justify-content-center mb-5">
<div class="col-12 col-md-10 col-lg-10">
<form method="get" class="d-flex" role="search">
<input class="form-control form-control-lg me-2 rounded-pill flex-grow-1" type="search" id="search-input" name="Query"
placeholder="Search for a team, artist, or event (e.g., Indiana basketball)"
value="@Model.Query" aria-label="Search">
<button class="btn btn-lg btn-primary rounded-pill" type="submit">Search</button>
</form>
</div>
</div>

<!-- Event Results Container -->

<div id="eventcontainer">
@if (Model.SearchPerformed && Model.Events.Count == 0)
{
<div class="alert alert-warning text-center" role="alert">
<h4 class="alert-heading">No Events Found!</h4>
<p>We couldn't find any events matching your search for "<strong>@Model.Query</strong>". Please try a different query.</p>
</div>
}
else if (Model.Events != null && Model.Events.Count > 0)
{
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
@foreach (var eventItem in Model.Events)
{
// Construct the link for the next page, passing the necessary details (ID and location for parking)
var parkingLink = $"/ParkingSearch?eventId={eventItem.Id}&lat={eventItem.Venue.Location.Lat}&lon={eventItem.Venue.Location.Lon}";

<div class="col">
<a href="@parkingLink" class="text-decoration-none">
<div class="card h-100 shadow-lg border-primary">
<!-- WHO: Implicitly the headliner/summary -->
<div class="card-header bg-primary text-white text-center">
@eventItem.GetPerformersSummary()
</div>
<div class="card-body text-center d-flex flex-column justify-content-between">
<div>
<!-- WHAT: The Event Title -->
<h5 class="card-title">@eventItem.Title</h5>

<!-- WHEN: Date and Time -->

<p class="card-text mb-1 mt-3">
<span class="event-detail-label d-block text-uppercase">Date & Time</span>
<span class="fw-bold text-dark fs-6">@eventItem.DatetimeLocal.ToString("ddd, MMM dd, yyyy")</span>
</p>
<p class="card-text mb-3 text-muted small">
@eventItem.DatetimeLocal.ToString("h:mm tt", CultureInfo.InvariantCulture)
</p>
</div>

<!-- WHERE: Location and Venue -->

<div>
<p class="card-text mb-0">
<span class="event-detail-label d-block text-uppercase">Venue</span>
<span class="fw-bold fs-6">@eventItem.Venue.NameV2</span>
</p>
<p class="card-text text-muted small">@eventItem.Venue.DisplayLocation</p>
</div>
</div>
<div class="card-footer text-end bg-light border-0">
<span class="btn btn-sm btn-outline-primary shadow-sm">Find Parking &rarr;</span>
</div>
</div>
</a>
</div>
}
</div>
}

</div>

</div>
<!-- The custom <style> block is placed here to avoid interfering with _Layout.cshtml -->
<style>
/* Custom styles to enhance the page look and feel /
.card {
box-shadow: 0 4px 8px rgba(0,0,0,0.1);
transition: transform 0.2s, box-shadow 0.2s;
border-radius: 12px;
border: 1px solid #dee2e6;
}
.card:hover {
transform: translateY(-5px);
box-shadow: 0 10px 20px rgba(0,0,0,0.2);
}
.card-header {
font-weight: 700;
font-size: 1.15rem;
padding: 1rem;
border-top-left-radius: 11px !important; / Adjust to match card radius /
border-top-right-radius: 11px !important;
}
.card-title {
font-size: 1.4rem;
margin-bottom: 0.25rem;
color: #343a40; / Dark text for emphasis /
}
/ Ensures the card content fills the height and centers elements vertically /
.card-body {
padding: 1.5rem;
}
/ Style for the link element that wraps the card /
.text-decoration-none:hover .card {
border-color: #0d6efd; / Highlight border on hover /
}
/ Make the event details pop a bit more */
.event-detail-label {
color: #6c757d;
font-size: 0.8rem;
letter-spacing: 0.05rem;
}
</style>