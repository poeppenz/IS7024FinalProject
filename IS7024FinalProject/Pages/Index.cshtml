@page
@model IndexModel
@{
    ViewData["Title"] = "Home Page";
}

<body class="bg-light">

    <!-- OUTER CONTAINER TO CENTER THE CARD -->
    <div class="container py-5 d-flex justify-content-center">

        <!-- WHITE CARD -->
        <div class="card shadow p-4" style="max-width: 900px; width: 100%; border-radius: 15px;">

            <!-- HERO SECTION -->
            <h1 class="text-center mb-4 fw-bold">Event Parking</h1>

            <!-- SEARCH BAR -->
            <div class="mb-4 text-center">
                <form action="/EventSearch" method="get" class="d-flex justify-content-center gap-2">
                    <input type="search"
                           name="query"
                           class="form-control w-50"
                           placeholder="Search an Event by Name or Location..."
                           required />

                    <button type="submit" class="btn btn-primary px-4">Search</button>
                </form>
            </div>

            <!-- DESCRIPTION -->
            <p class="text-center mb-5" style="max-width: 700px; margin: auto;">
                Locating a parking spot even before you reserve your events motivates you even more
                not to fail to attend not only yourself but with your family as well.
                Events could range from basketball, football, concerts, musicals etc.
                Name it — we have the parking spot for you.
            </p>

            <!-- IMAGE -->
            <div class="text-center mb-4">
                <img src="~/logo_300x300.png" style="max-width: 300px;" alt="Parking logo" />
            </div>

            <!-- PARKWHIZ SECTION -->
            <h2 class="text-center fw-bold mb-3">Search Parkwhiz Venues</h2>

            <form method="get" asp-page="/API/ParkwhizVenue1"
                  class="row g-3 justify-content-center">

            <form method="get" asp-page="/API/ParkwhizVenue1" class="row g-2 align-items-center">
                <div class="col-auto">
                    <label class="form-label visually-hidden" for="Lat">Latitude</label>
                    <input id="Lat" name="Lat" class="form-control" placeholder="Latitude (e.g. 39.103100)" value="39.103100" />
                </div>
                <div class="col-auto">
                    <label class="form-label visually-hidden" for="Lon">Longitude</label>
                    <input id="Lon" name="Lon" class="form-control" placeholder="Longitude (e.g. -84.512000)" value="-84.512000" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Search</button>
                </div>
            </form>

            <p class="mt-3 text-muted">Enter GPS coordinates and press Search. You'll be taken to the Parkwhiz Venues page with the coordinates in the URL.</p>
        </div>
    </div>
</body>
