@page
@model IndexModel
@{
    ViewData["Title"] = "Home Page";
}

<head>
    <link rel="stylesheet" href="site.css" type="text/css" />
</head>

<body>
    <div id="homebanner" class="fullwidth">
        <h1>Project Name</h1>
        <div id="search">
            <form action="/search" method="get">
                <input type="search" id="search-input" name="query" placeholder="Search an Event...">
                <button type="submit">Search</button>
            </form>
        </div>
    </div>
    <div id="support" class="fullwidth">
        <div id="broll" class="supportsection">
            <img src="https://github.com/poeppenz/IS7024FinalProject/blob/master/Assets/logo.png" />
        </div>
        <div id="usage" class="supportsection">
            <h3>How to Use</h3>
            <ul>
                <li>Search an event to find parking</li>
                <li>Test Test Test</li>
            </ul>
        </div>
    </div>
</body>
