@page
@model IndexModel
@{
    ViewData["Title"] = "Home Page"; <img src= alt="Home icon"/>
}
<link rel="stylesheet" href="css/StyleSheet.css" type="text/css" />
<link rel="stylesheet" href="css/print.css" type="text/css" />
<link rel="stylesheet" href="/css/Mobile.css" type="text/css" media="screen and (max-device-width: 480px)"/>


<body class="bg-light">

    <!-- OUTER CONTAINER TO CENTER THE CARD -->
    <div class="container py-5 d-flex justify-content-center">

        <!-- WHITE CARD -->
        <div class="card shadow p-4" style="max-width: 900px; width: 100%; border-radius: 15px;">

            <!-- HERO SECTION -->
            <h1 class="text-center mb-4 fw-bold">Event Parking</h1>

            <!-- SEARCH BAR -->
            <div class="mb-4 text-center">
                <form action="/EventSearch" 
                    method="get" 
                    class="d-flex justify-content-center gap-2" 
                    aria-label="Search events by name or location">
                    <input type="search"
                           name="query"
                           class="form-control w-50"
                           placeholder="Search an Event by Name or Location..."
                           required />

                    <button type="submit" class="btn btn-primary px-4">Search</button>
                </form>
            </div>

            <!-- DESCRIPTION -->
            <p class="text-center mb-5" style="max-width: 700px; margin: auto;">
               </p>
            <p>
                Locating a parking spot even before you reserve your events motivates you even more
                not to fail to attend not only yourself but with your family as well.
                Events could range from basketball, football, concerts, musicals etc.
                Name it we have the parking spot for you.
            </p>
             <div id= "content">
            <!-- IMAGE -->
            <div class="text-center mb-4">
                <img src="~/logo_300x300.png" style="max-width: 300px;" alt="The Event Parking Logo: A car on a platform." />
            </div>
          
            <!-- PARKWHIZ SECTION -->

              <div class="text-center fw-bold mb-3"><h3>Search Parkwhiz Venues</h3></div>

            <form method="get" asp-page="/API/ParkwhizVenue1"
                  class="row g-3 justify-content-center"> 

                <div class="col-md-4">
                    <label class="form-label">Latitude</label>
                    <input id="Lat"
                           name="Lat"
                           class="form-control"
                           placeholder="e.g. 39.103100"
                           value="39.103100"
                           required />
                </div>
                <div class="col-auto">
                    <label class="form-label visually-hidden" for="Lon">Longitude</label>
                    <input id="Lon" name="Lon" class="form-control" placeholder="Longitude (e.g. -84.512000)" value="-84.512000" /> 
                </div>

                <div class="col-12 text-center">
                    <button type="submit" class="btn btn-success px-4">Search</button>
                </div>
           
           </form> 

            <p class="mt-3 text-center text-muted"> <p>Enter GPS coordinates and press Search. You'll be taken to the Parkwhiz Venues page with the coordinates in the URL.</P> </p>
            
           

        </div> 

    </div> 
</body>
