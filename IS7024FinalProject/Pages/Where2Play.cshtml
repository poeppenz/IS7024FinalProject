@page
@model IS7024FinalProject.Pages.Where2PlayModel

@{
    ViewData["Title"] = "Concert Event Search";
}

<div class="container my-5">
    <div class="text-center mb-4">
        <h1 class="display-4 text-info">Where2Play Concert Finder</h1>
        <p class="lead text-muted">Searching for events in **@Model.City** powered by the Where2Play API.</p>
    </div>

    <!-- City Search Form -->
    <div class="row justify-content-center mb-5">
        <div class="col-12 col-md-8 col-lg-6">
            <form method="get" class="d-flex shadow-lg rounded-pill p-1 bg-white border border-info">
                <input class="form-control me-2 border-0" type="search" name="City"
                    placeholder="Enter a city (e.g., Nashville)" value="@Model.City" aria-label="Search by City"
                    required />
                <button class="btn btn-info rounded-pill px-4 text-white fw-bold" type="submit">Search Events</button>
            </form>
        </div>
    </div>

    <!-- Display Error Message if any -->
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger text-center shadow" role="alert">
            <h4 class="alert-heading">Request Failed!</h4>
            <p>@Model.ErrorMessage</p>
        </div>
    }

    <!-- Display Results -->
    @if (Model.Events.Count > 0)
    {
        <h2 class="h4 mb-4 text-center text-secondary">Found @Model.Events.Count Concerts in @Model.City</h2>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var eventItem in Model.Events)
            {
                <div class="col">
                    <div class="card h-100 shadow-lg border-start border-5 border-info rounded-3">
                        <div class="card-body d-flex flex-column">

                            <!-- Artist Name -->
                            <h5 class="card-title text-primary mb-1">
                                @eventItem.ArtistName
                            </h5>

                            <!-- Genre -->
                            @if (!string.IsNullOrEmpty(eventItem.Genre))
                            {
                                <span class="badge bg-secondary mb-3">@eventItem.Genre</span>
                            }

                            <!-- Event Details -->
                            <div class="mt-2">
                                <p class="card-text mb-1">
                                    <small class="text-muted d-block">Venue:</small>
                                    <span class="fw-bold">@eventItem.Venue</span>
                                </p>
                                <p class="card-text mb-1">
                                    <small class="text-muted d-block">When:</small>
                                    <span class="text-dark">@eventItem.FormattedDate</span>
                                </p>
                                @if (!string.IsNullOrEmpty(eventItem.Country))
                                {
                                    <p class="card-text mb-1">
                                        <small class="text-muted d-block">Origin:</small>
                                        <span class="text-dark">@eventItem.Country</span>
                                    </p>
                                }
                                <p class="card-text mb-1">
                                    <small class="text-muted d-block">Popularity:</small>
                                    <span class="text-warning fw-bold">@eventItem.Popularity</span>
                                </p>
                            </div>

                            <!-- Link to details -->
                            <div class="mt-auto pt-3">
                                @if (!string.IsNullOrEmpty(eventItem.Url))
                                {
                                    <a href="@eventItem.Url" target="_blank" class="btn btn-outline-info btn-sm">
                                        View Setlist/Details &rarr;
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (Model.Events.Count == 0 && !string.IsNullOrWhiteSpace(Model.City))
    {
        <!-- Display if search was run but returned no results -->
        <div class="alert alert-light text-center border shadow-sm" role="alert">
            <h4 class="alert-heading text-secondary">No Concerts Found!</h4>
            <p>There are no concert events listed for **@Model.City** at this time, or the city is not one of the supported
                demo cities.</p>
        </div>
    }
</div>